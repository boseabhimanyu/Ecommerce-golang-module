MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=<db_name>
PORT=<serverport>
JWT_SECRET=<secret_long_string>
JWT_EXPIRY_HOURS=24
GIN_MODE=debug
# or release
#ALLOWED_ORIGINS=http://localhost:<frontend-serverport>
AUTH_ACCESS_COOKIE=access_token
AUTH_REFRESH_COOKIE=refresh_token

REFRESH_TOKEN_EXPIRY_DAYS=30
REFRESH_TOKEN_REVOKED_RETENTION_DAYS=7
REFRESH_TOKEN_EXPIRED_RETENTION_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TOTP_ISSUER=Basic App
TOTP_ENCRYPTION_KEY=<32-byte-secret>
BACKUP_CODE_COUNT=10
BACKUP_CODE_LOW_THRESHOLD=4

# Email / SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com       # or smtp.gmail.com / sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your-smtp-login-email
SMTP_PASSWORD=your-smtp-password-or-app-key
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME="Store Name"
EMAIL_PROVIDER=smtp                  # "logger" for dev console, "smtp" for real email

# Token Expiry Durations (Go duration format: 24h, 1h, 30m)
EMAIL_VERIFICATION_EXPIRY=24h
PASSWORD_RESET_EXPIRY=1h
